# Digi Dental — environment variables
# Copy to .env locally; enter real values ONLY in .env and your hosting dashboard.
# NEVER commit real keys.

# The API URL is derived from the Supabase PROJECT REF, not its display name — renaming the
# project in Supabase does not change this value. api/*.ts also accept SUPABASE_URL or
# NEXT_PUBLIC_SUPABASE_URL, which is what the Supabase→Vercel integration creates.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key            # public anon key — safe for browser, protected by RLS
VITE_VAPI_PUBLIC_KEY=your-vapi-public-web-key          # the ONLY Vapi key allowed in the browser
VITE_VAPI_ASSISTANT_ID=your-demo-assistant-id          # a UUID; the page refuses to call without it
# NEVER put a Vapi PRIVATE/server key in the browser. Only the public web key belongs client-side.
# Both values are also inlined in index.html for this static build (VAPI_PUBLIC_KEY /
# VAPI_ASSISTANT_ID); update them together or the demo will refuse to start rather than place a
# call with no assistant attached.
RESEND_API_KEY=re_xxxxxxxx                             # SECURITY: server-side only, never expose
NOTIFY_EMAIL_TO=bennysworkspace@gmail.com

# Server-side only (serverless functions in api/) — NEVER expose in the browser:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # full-access key for api/*.ts (SUPABASE_SECRET_KEY also accepted as an alias)
IP_HASH_SALT=your-random-salt                          # salts the SHA-256 of visitor IPs in api/demo-session.ts and api/event.ts

# Lead email sender. Until a domain is verified in Resend, api/notify-lead falls back to
# Resend's onboarding@resend.dev, which lands in spam and doesn't read as Digi Dental.
RESEND_FROM=Digi Dental <noreply@your-domain.com>

# Optional shared secret for /api/notify-lead. When set, the endpoint only accepts requests
# carrying the same value in the x-dd-site header — i.e. requests from the page itself.
# Must match SITE_TOKEN in index.html. Leave unset and the check is skipped.
SITE_TOKEN=dd-site-2026

# Video sources served through /api/video, so the page never embeds an expiring token.
# Preferred: make the Supabase bucket public and paste the public URLs here (they never expire).
# Interim: paste fresh signed URLs. Unset falls back to the signed URLs hardcoded in api/video.ts,
# which expire 2027-07-24.
VIDEO_VSL_URL=
VIDEO_DEMO_URL=

# Images served through /api/image?name=… so the page carries no expiring Supabase token.
# The signed URLs hardcoded as a fallback in api/image.ts EXPIRE 2027-08-10. Permanent fix: make
# the `Images` bucket public in Supabase and set these to the /object/public/... URLs.
IMAGE_PROFILE_URL=
IMAGE_DASH_ASSISTANT_URL=
IMAGE_DASH_CALL_URL=
IMAGE_DASH_LOGS_URL=
IMAGE_DASH_METRICS_URL=

# Admin dashboard at /admin.html. Required: without it the dashboard refuses to load rather
# than falling open. Pick something long and random; it is the only thing standing between
# the public internet and your lead list.
ADMIN_PASSWORD=

# Signs the admin session cookie. Keep it separate from the password: a signing key should be
# long and random, and a password you type is neither. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the password is used as the signing key so an existing deployment keeps working.
ADMIN_SESSION_SECRET=

# Bump this (1 → 2 → 3 …) to sign every admin session out at once, e.g. if a laptop goes missing.
ADMIN_SESSION_VERSION=1

# How long an admin login lasts, in hours. Default 168 (7 days). 24 is a reasonable tightening
# for a dashboard that displays customer contact details.
ADMIN_SESSION_HOURS=168
